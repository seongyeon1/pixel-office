{
  "name": "pixel-agent-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json && npm run build:desktop",
    "build:desktop": "tsc -p tsconfig.desktop.json && node scripts/desktop-icon.mjs",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "postinstall": "node scripts/prepare-pty.mjs",
    "service:install": "npm run build && node dist/desktop/service-cli.js install",
    "service:start": "node dist/desktop/service-cli.js start",
    "service:stop": "node dist/desktop/service-cli.js stop",
    "service:status": "node dist/desktop/service-cli.js status",
    "service:open": "node dist/desktop/service-cli.js open",
    "service:uninstall": "node dist/desktop/service-cli.js uninstall",
    "desktop": "electron dist/desktop/main.js",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "desktop:install": "npm run service:install && node scripts/package-desktop.mjs --install",
    "test:desktop": "playwright test -c playwright.desktop.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "@fastify/middie": "^9.3.4",
    "@fastify/static": "^10.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "fastify": "^5.12.5",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
